(defcfg
  process-unmapped-keys yes
)


(defsrc
  grv  1    2    3    4    5    6    7    8    9    0    -    =    bspc
  tab  q    w    e    r    t    y    u    i    o    p    [    ]    \
  caps a    s    d    f    g    h    j    k    l    ;    '    ret
  lsft < z    x    c    v    b    n    m    ,    .    /    rsft
  lctl lmet lalt           spc            ralt rmet rctl
)

(defalias
	capsmod (tap-hold-release 110 110 esc (layer-while-held keys))
	spacemod (tap-hold-release 200 200 spc (layer-while-held nav))
)

(deflayer base 
	_ _ _ _ _ _ _ _ _ _ _ _ _ _ 
	_ _ _ _ _ _ _ _ _ _ _ _ _ _ 
	@capsmod _ _ _ _ _ _ _ _ _ _ _ _  
	_ _ _ _ _ _ _ _ _ _ _ _ _ 
	_ _ _ @spacemod _ _ _ 
) 
	
(deflayer keys 
	_ _ _ _ _ _ _ _ _ _ _ _ _ _ 
	_ _ _ _ _ _ _ (multi ralt 7) (multi ralt 0) (multi lsft 2) ] (multi lsft ]) _ _ 
	_ _ _ _ _ _ < (multi lsft 8) (multi lsft 9) (multi lsft <) (multi lsft 0) (multi lsft 7) _  
	_ _ _ _ _ _ _ _ (multi ralt 8) (multi ralt 9) (multi ralt <) (multi lsft 1) _  
	_ _ _ _ _ _ _ 
)


(deflayer nav 
	_ _ _ _ _ _ _ _ _ _ _ _ _ _ 
	_ (multi lctl w) _ _ _ _ _ _ _ f11 _ _ _ _ 
	_ _ (multi lctl pgup) (multi lctl pgdn) (multi lalt tab) _ _ down up _ _ _ _  
	_ _ _ _ _ _ _ (multi lctl t) _ _ _ _ _  
  
	_ _ _ _ _ _ _ 
)
