(defcfg
  process-unmapped-keys yes
)

(defsrc
  grv  1    2    3    4    5    6    7    8    9    0    -    =    bspc
  tab  q    w    e    r    t    y    u    i    o    p    [    ]
  caps a    s    d    f    g    h    j    k    l    ;    '    \    ret
  lsft < z    x    c    v    b    n    m    ,    .    /    rsft
  lctl lmet lalt           spc            ralt rmet rctl
)

(defalias
	fmod (tap-hold 200 200 f (layer-while-held keysR))
	jmod (tap-hold 200 200 j (layer-while-held keysL)) 
	spacemod (tap-hold-release 200 200 spc (layer-while-held nav)) oldralt (layer-while-held at)
	numlmod (tap-hold 200 200 ; (layer-while-held numL))
	numrmod (tap-hold 200 200 a (layer-while-held numR))
	fourspc (macro spc spc spc spc)
)

(deflayer base 
	_ _ _ _ _ _ _ _ _ _ _ _ _ _ 
	_ _ _ _ _ _ _ _ _ _ _ _ _ 
	esc @numrmod _ _ @fmod _ _ @jmod _ _ @numlmod _ _ _  
	_ @oldralt _ _ _ _ _ _ _ _ _ _ _ 
	_ _ _ @spacemod _ _ _ 
) 
	
(deflayer keysR 
	_ _ _ _ _ _ _ _ _ _ _ _ _ _ 
	_ _ _ _ _ _ _ (multi ralt 7) (multi ralt 0) (multi lsft 2) ] (multi lsft ]) _ 
	_ _ _ _ _ _ < (multi lsft 8) (multi lsft 9) (multi lsft <) (multi lsft 0) (multi lsft 7) _ _  
	_ _ _ _ _ _ _ (multi ralt -) (multi ralt 8) (multi ralt 9) (multi ralt <) (multi lsft 1) _  
	_ _ _ _ _ _ _ 
)

(deflayer keysL
	_ _ _ _ _ _ _ _ _ _ _ _ _ _ 
	_ _ _ _ _ _ _ _ _ _ _ _ _  
	@fourspc (multi ralt q) (multi lsft 4) (multi lsft 5) (multi lsft 6) \ (multi ralt ]) _ _ _ _ _ _ _ 
	_ _ _ _ (multi ralt -) (multi lsft 7) _ _ _ _ _ _ _ 
	_ _ _ _ _ _ _ 
)

(deflayer numR
	_ _ _ _ _ _ _ _ _ _ _ _ _ _ 
	_ _ _ _ _ _ _ _ _ bspc _ _ _ 
	_ _ _ _ _ _ 6 7 8 9 0 ret _ _  
	_ _ _ _ _ _ _ _ _ _ _ _ _ 
	_ _ _ _ _ _ _ 
)

(deflayer numL
	_ _ _ _ _ _ _ _ _ _ _ _ _ _ 
	_ _ _ _ _ _ _ _ _ _ _ _ _ 
	_ 1 2 3 4 5 _ _ _ _ _ _ _ _  
	_ _ _ _ _ _ _ _ _ _ _ _ _ 
	_ _ _ _ _ _ _ 
)
(deflayer at
	_ _ _ _ _ _ _ _ _ _ _ (multi ralt -)  _ _ 
	_ _ _ _ _ _ _ _ _ _ _ _ _  
	_ _ _ _ _ _ _ _ _ _ _ _ _ _  
	_ _ _ _ _ _ _ _ _ _ _ _ _ 
	_ _ _ _ _ _ _ 

)
(deflayer nav 
	_ _ _ _ _ _ _ _ _ _ _ _ _ _ 
	_ (multi lctl w) _ _ _ _ _ _ _ _ _ _ _  
	_ _ (multi lctl pgup) (multi lctl pgdn) (multi lalt tab) _ _ down up _ f11 (multi lctl l) _ _ 
	_ _ _ _ _ _ _ (multi lctl t) _ _ _ _ _  
  
	_ _ _ _ _ _ _ 
)
